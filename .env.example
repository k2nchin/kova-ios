# Kova Environment Variables Example
# Backend API and realtime socket
VITE_KOVA_API_URL=http://localhost:4000/api
VITE_KOVA_SOCKET_URL=http://localhost:4000

# Producción: URL pública de la API (la app de escritorio usará esta dirección)
# VITE_KOVA_API_URL=https://api.tu-dominio.com/api
# VITE_KOVA_SOCKET_URL=https://api.tu-dominio.com

# Development only. Never enable in production.
VITE_ALLOW_OFFLINE_AUTH=false

# Google OAuth 2.0 Web Client ID (authorize http://localhost:1420)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Gemini credentials belong in the backend environment, never in Vite variables.
