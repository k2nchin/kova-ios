{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Kova",
  "version": "1.0.20",
  "identifier": "com.kova.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Kova",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#0a0a0b",
        "center": true,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 http://localhost:4000 ws://localhost:4000 https: wss:; img-src 'self' asset: http://asset.localhost data: blob: https:; media-src 'self' asset: http://asset.localhost data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self' https://accounts.google.com; frame-src https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxREYxRDYyNkJDRUNBQzgKUldUSXlzNXJZaDNmMFVkU3A0VGhHVGtkMElCZ0JwME9yVnhFT1poYjJ2T0haeTJuVXZrUjMybEUK",
      "endpoints": ["https://kova-k2nchin.vercel.app/updates/latest.json", "https://kova-ios.onrender.com/api/updates/latest.json"],
      "windows": { "installMode": "passive" }
    },
    "deep-link": {
      "mobile": [
        {
          "host": "auth",
          "pathPrefix": ["/"]
        }
      ],
      "desktop": {
        "schemes": ["kova"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "resources": { "WebView2Loader.dll": "WebView2Loader.dll" },
    "publisher": "Kova",
    "homepage": "https://kova-k2nchin.vercel.app",
    "copyright": "© 2026 Kova",
    "license": "LicenseRef-Proprietary",
    "category": "SocialNetworking",
    "shortDescription": "Espacios de voz, mensajes y señales para tu comunidad.",
    "longDescription": "Kova reúne tus comunidades en espacios de voz, mensajes y señales con una experiencia de escritorio rápida y privada.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Kova",
        "languages": ["Spanish"],
        "headerImage": "installer-assets/header.bmp",
        "sidebarImage": "installer-assets/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
